<Window x:Class="GestionMail.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GestionMail"
        Title="To-Do list" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <local:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <local:BoolToTextDecorationConverter x:Key="BoolToTextDecorationConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="LstTaches" Grid.Row="0" Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding Titre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" MinWidth="220"
                                 Foreground="{Binding IsDone, Converter={StaticResource BoolToBrushConverter}}"
                                 TextDecorations="{Binding IsDone, Converter={StaticResource BoolToTextDecorationConverter}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtNouvelleTache" Grid.Column="0" Margin="0,0,8,0" Padding="3"/>
            <Button x:Name="BtnAjouter" Content="Ajouter" Grid.Column="1" Width="80" Click="BtnAjouter_Click"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSupprimer" Content="Supprimer" Width="90" Margin="0,0,8,0" Click="BtnSupprimer_Click"/>
            <Button x:Name="BtnEnregistrer" Content="Enregistrer" Width="90" Click="BtnEnregistrer_Click"/>
        </StackPanel>
    </Grid>
</Window>